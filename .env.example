# Copier ce fichier en `.env` et remplir avec vos vraies valeurs.
# `.env` est ignore par git : il ne doit JAMAIS etre commite.
#
# Sans .env, docker-compose utilise les valeurs par defaut (factorytrack)
# qui sont des credentials de demo locale uniquement.

# Credentials PostgreSQL / TimescaleDB
POSTGRES_DB=factorytrack
POSTGRES_USER=factorytrack
POSTGRES_PASSWORD=changer-moi-en-production
