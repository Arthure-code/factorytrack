<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.36.2" />
    <PackageReference Include="Grpc.Tools" Version="2.85.0" PrivateAssets="All" />
    <PackageReference Include="Grpc.Net.Client" Version="2.84.0" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="Protos\ingestion.proto" GrpcServices="Both" />
  </ItemGroup>
</Project>
