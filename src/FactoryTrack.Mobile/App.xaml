<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:FactoryTrack.Mobile"
             xmlns:conv="clr-namespace:FactoryTrack.Mobile.Converters"
             x:Class="FactoryTrack.Mobile.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:ConvertisseurEtatConnexion x:Key="ConvertisseurEtatConnexion" />
            <conv:ConvertisseurLibelleConnexion x:Key="ConvertisseurLibelleConnexion" />
            <conv:ConvertisseurInverseBool x:Key="ConvertisseurInverseBool" />
            <conv:ConvertisseurTexteVersVisible x:Key="ConvertisseurTexteVersVisible" />
            <conv:ConvertisseurCompteVersVisible x:Key="ConvertisseurCompteVersVisible" />
            <conv:ConvertisseurEtatPrecision x:Key="ConvertisseurEtatPrecision" />
            <conv:ConvertisseurAlerteCouleur x:Key="ConvertisseurAlerteCouleur" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
