<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:FactoryTrack.Mobile.Controls"
             xmlns:vm="clr-namespace:FactoryTrack.Mobile.ViewModels"
             x:Class="FactoryTrack.Mobile.Pages.PageDetailEquipement"
             x:DataType="vm:DetailEquipementViewModel"
             Title="{Binding Code}">

    <Grid RowDefinitions="Auto,Auto,*,Auto" Padding="12" RowSpacing="10">

        <!-- En-tete -->
        <VerticalStackLayout Grid.Row="0" Spacing="2">
            <Label Text="{Binding Nom}"
                   FontSize="{StaticResource FontSizeXl}"
                   FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light={StaticResource BrandOnMuted}, Dark={StaticResource BrandLight}}"/>
            <Label Text="{Binding Categorie, StringFormat='Categorie : {0}'}"
                   Style="{StaticResource LabelDiscret}"/>
        </VerticalStackLayout>

        <!-- Statistiques -->
        <Border Grid.Row="1"
                Style="{StaticResource BorderCarte}"
                Padding="12,10">
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="20">

                <VerticalStackLayout Grid.Column="0">
                    <Label Text="Points sur 30 min" Style="{StaticResource LabelDiscret}"/>
                    <Label Text="{Binding NombrePositions}" Style="{StaticResource LabelStatistique}"/>
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="1">
                    <Label Text="Distance parcourue" Style="{StaticResource LabelDiscret}"/>
                    <Label Text="{Binding DistanceParcourueMetres, StringFormat='{0} m'}"
                           Style="{StaticResource LabelStatistique}"/>
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="2">
                    <Label Text="Precision moyenne" Style="{StaticResource LabelDiscret}"/>
                    <Label Text="{Binding PrecisionMoyenne, StringFormat='{0} m'}"
                           Style="{StaticResource LabelStatistique}"/>
                </VerticalStackLayout>

            </Grid>
        </Border>

        <!-- Trace -->
        <Border Grid.Row="2" Style="{StaticResource BorderCarte}">
            <Grid>
                <controls:VueTraceEquipement
                    LargeurUsine="{Binding LargeurUsine}"
                    HauteurUsine="{Binding HauteurUsine}"
                    Passerelles="{Binding Passerelles}"
                    Positions="{Binding Positions}"/>

                <ActivityIndicator IsRunning="{Binding Chargement}"
                                   IsVisible="{Binding Chargement}"
                                   VerticalOptions="Center"
                                   HorizontalOptions="Center"/>

                <Label Text="Aucune position sur les 30 dernieres minutes."
                       Style="{StaticResource LabelDiscret}"
                       VerticalOptions="Center"
                       HorizontalOptions="Center">
                    <Label.Triggers>
                        <MultiTrigger TargetType="Label">
                            <MultiTrigger.Conditions>
                                <BindingCondition Binding="{Binding Chargement}" Value="False"/>
                                <BindingCondition Binding="{Binding NombrePositions}" Value="0"/>
                            </MultiTrigger.Conditions>
                            <Setter Property="IsVisible" Value="True"/>
                        </MultiTrigger>
                    </Label.Triggers>
                    <Label.IsVisible>False</Label.IsVisible>
                </Label>
            </Grid>
        </Border>

        <!-- Erreur -->
        <Border Grid.Row="3"
                Style="{StaticResource BorderAlerteDanger}"
                IsVisible="{Binding MessageErreur, Converter={StaticResource ConvertisseurTexteVersVisible}}">
            <Label Text="{Binding MessageErreur}"
                   TextColor="{StaticResource OnDangerMuted}"
                   FontSize="{StaticResource FontSize}"/>
        </Border>

    </Grid>
</ContentPage>
