<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FactoryTrack.Mobile.ViewModels"
             x:Class="FactoryTrack.Mobile.Pages.PageHistoriqueAlertes"
             x:DataType="vm:HistoriqueAlertesViewModel"
             Title="Historique des alertes">

    <Grid RowDefinitions="Auto,Auto,*,Auto" Padding="12" RowSpacing="8">

        <!-- Barre d'actions groupees -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                <Label Text="{Binding Alertes.Count, StringFormat='{0} entree(s)'}"
                       Style="{StaticResource LabelTitreCarte}"
                       FontSize="{StaticResource FontSize}"
                       VerticalOptions="Center"/>
                <Label Text="{Binding NombreSelectionnees, StringFormat=' · {0} selectionnee(s)'}"
                       Style="{StaticResource LabelDiscret}"
                       VerticalOptions="Center"
                       IsVisible="{Binding NombreSelectionnees, Converter={StaticResource ConvertisseurCompteVersVisible}}"/>
            </HorizontalStackLayout>

            <Button Grid.Column="1"
                    Style="{StaticResource BoutonIcone}"
                    Text="↻"
                    FontSize="{StaticResource FontSizeL}"
                    Command="{Binding ChargerCommand}"/>
        </Grid>

        <!-- Boutons d'actions par lot -->
        <ScrollView Grid.Row="1" Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
            <HorizontalStackLayout Spacing="6">
                <Button Style="{StaticResource BoutonSecondaire}"
                        Text="Tout selectionner"
                        FontSize="{StaticResource FontSizeS}"
                        Padding="10,6"
                        Command="{Binding ToutSelectionnerCommand}"/>
                <Button Style="{StaticResource BoutonSecondaire}"
                        Text="Rien"
                        FontSize="{StaticResource FontSizeS}"
                        Padding="10,6"
                        Command="{Binding ToutDeselectionnerCommand}"/>
                <Button Style="{StaticResource BoutonDanger}"
                        Text="Supprimer selection"
                        FontSize="{StaticResource FontSizeS}"
                        Padding="10,6"
                        Command="{Binding SupprimerSelectionCommand}"
                        IsEnabled="{Binding NombreSelectionnees, Converter={StaticResource ConvertisseurCompteVersVisible}}"/>
                <BoxView WidthRequest="1"
                         Color="{AppThemeBinding Light={StaticResource N200}, Dark={StaticResource N600}}"/>
                <Button Style="{StaticResource BoutonDangerOutline}"
                        Text="Purger &gt; 1 h"
                        FontSize="{StaticResource FontSizeS}"
                        Padding="10,6"
                        Command="{Binding SupprimerAvantUneHeureCommand}"/>
                <Button Style="{StaticResource BoutonDangerOutline}"
                        Text="Purger avant aujourd'hui"
                        FontSize="{StaticResource FontSizeS}"
                        Padding="10,6"
                        Command="{Binding SupprimerAvantAujourdhuiCommand}"/>
            </HorizontalStackLayout>
        </ScrollView>

        <!-- Liste des alertes -->
        <Border Grid.Row="2" Style="{StaticResource BorderCarte}">
            <Grid>
                <CollectionView ItemsSource="{Binding Alertes}">
                    <CollectionView.EmptyView>
                        <Label Text="Aucune alerte dans l'historique."
                               Style="{StaticResource LabelDiscret}"
                               FontSize="{StaticResource FontSizeM}"
                               HorizontalOptions="Center" VerticalOptions="Center"
                               Padding="20"/>
                    </CollectionView.EmptyView>
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="0"/>
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:AlerteHistoriqueApercu">
                            <Grid Padding="12,10" ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="10">
                                <CheckBox IsChecked="{Binding Selectionnee, Mode=TwoWay}"
                                          VerticalOptions="Center"/>
                                <Label Grid.Column="1"
                                       Text="⚠"
                                       FontSize="{StaticResource FontSizeM}"
                                       VerticalOptions="Center"
                                       TextColor="{Binding EstAlerteRouge, Converter={StaticResource ConvertisseurAlerteCouleur}}"/>
                                <VerticalStackLayout Grid.Column="2" Spacing="1" VerticalOptions="Center">
                                    <Label FontSize="{StaticResource FontSize}">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{Binding CodeEquipement}"
                                                      FontAttributes="Bold"
                                                      TextColor="{AppThemeBinding Light={StaticResource BrandDark}, Dark={StaticResource BrandLight}}"/>
                                                <Span Text="  ·  "
                                                      TextColor="{AppThemeBinding Light={StaticResource N500}, Dark={StaticResource N300}}"/>
                                                <Span Text="{Binding ZoneNom}"
                                                      TextColor="{AppThemeBinding Light={StaticResource N700}, Dark={StaticResource N100}}"/>
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                    <Label Text="{Binding TypeLibelle}"
                                           Style="{StaticResource LabelDiscret}"
                                           FontSize="{StaticResource FontSizeS}"/>
                                </VerticalStackLayout>
                                <Label Grid.Column="3"
                                       Text="{Binding HorodatageFormatte}"
                                       Style="{StaticResource LabelDiscret}"
                                       FontSize="{StaticResource FontSizeS}"
                                       VerticalOptions="Center"/>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <ActivityIndicator IsRunning="{Binding Chargement}" IsVisible="{Binding Chargement}"
                                   HorizontalOptions="Center" VerticalOptions="Center"/>
            </Grid>
        </Border>

        <!-- Messages -->
        <VerticalStackLayout Grid.Row="3" Spacing="4">
            <Border Style="{StaticResource BorderAlerteDanger}"
                    IsVisible="{Binding MessageErreur, Converter={StaticResource ConvertisseurTexteVersVisible}}">
                <Label Text="{Binding MessageErreur}"
                       TextColor="{StaticResource OnDangerMuted}"
                       FontSize="{StaticResource FontSizeS}"/>
            </Border>
            <Border Style="{StaticResource BorderAlerteSuccess}"
                    IsVisible="{Binding MessageInfo, Converter={StaticResource ConvertisseurTexteVersVisible}}">
                <Label Text="{Binding MessageInfo}"
                       TextColor="{StaticResource OnSuccessMuted}"
                       FontSize="{StaticResource FontSizeS}"/>
            </Border>
        </VerticalStackLayout>
    </Grid>
</ContentPage>
