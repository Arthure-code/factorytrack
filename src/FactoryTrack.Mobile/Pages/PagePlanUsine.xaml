<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:FactoryTrack.Mobile.Controls"
             xmlns:vm="clr-namespace:FactoryTrack.Mobile.ViewModels"
             x:Class="FactoryTrack.Mobile.Pages.PagePlanUsine"
             x:DataType="vm:PlanUsineViewModel"
             Title="Plan de l'usine">

    <!-- Grille racine avec overlays superposes pour les panneaux flottants -->
    <Grid>
        <!-- Contenu principal -->
        <Grid RowDefinitions="Auto,*,Auto,Auto" Padding="12" RowSpacing="8">

            <!-- Bandeau superieur : etat + boutons cloche et menu -->
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto">
                <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                    <Ellipse WidthRequest="10" HeightRequest="10"
                             Fill="{Binding Connecte, Converter={StaticResource ConvertisseurEtatConnexion}}"
                             VerticalOptions="Center"/>
                    <Label Text="{Binding Connecte, Converter={StaticResource ConvertisseurLibelleConnexion}}"
                           Style="{StaticResource LabelCorps}"
                           VerticalOptions="Center"/>
                    <Label Text="{Binding Equipements.Count, StringFormat=' · {0} equipements'}"
                           Style="{StaticResource LabelDiscret}"
                           VerticalOptions="Center"/>
                </HorizontalStackLayout>

                <!-- Bouton cloche avec badge compteur d'alertes -->
                <Grid Grid.Column="1" WidthRequest="40" HeightRequest="36" VerticalOptions="Center">
                    <Button Text="🔔"
                            Style="{StaticResource BoutonIcone}"
                            FontSize="18"
                            Command="{Binding BasculerPanneauAlertesCommand}"/>
                    <Border Style="{StaticResource BorderBadgeCompteur}"
                            IsVisible="{Binding Alertes.Count, Converter={StaticResource ConvertisseurCompteVersVisible}}"
                            Padding="5,1"
                            MinimumWidthRequest="18"
                            HeightRequest="18"
                            HorizontalOptions="End"
                            VerticalOptions="Start"
                            Margin="0,2,0,0"
                            InputTransparent="True">
                        <Label Text="{Binding Alertes.Count}"
                               TextColor="{StaticResource N0}"
                               FontSize="{StaticResource FontSizeXs}"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"/>
                    </Border>
                </Grid>

                <!-- Bouton menu 3 points -->
                <Button Grid.Column="2"
                        Text="⋮"
                        Style="{StaticResource BoutonIcone}"
                        FontSize="22"
                        FontAttributes="Bold"
                        VerticalOptions="Center"
                        Command="{Binding BasculerMenuCommand}"/>
            </Grid>

            <!-- Plan -->
            <Border Grid.Row="1" Style="{StaticResource BorderCarte}">
                <Grid>
                    <controls:VuePlanUsine
                        LargeurUsine="{Binding LargeurUsine}"
                        HauteurUsine="{Binding HauteurUsine}"
                        Passerelles="{Binding Passerelles}"
                        Zones="{Binding Zones}"
                        Machines="{Binding Machines}"
                        Equipements="{Binding Equipements}"
                        AfficherPrecision="{Binding AfficherPrecision}"
                        EquipementTapeCommand="{Binding OuvrirDetailCommand}"/>

                    <ActivityIndicator IsRunning="{Binding Chargement}"
                                       IsVisible="{Binding Chargement}"
                                       VerticalOptions="Center"
                                       HorizontalOptions="Center"/>
                </Grid>
            </Border>

            <!-- Legende visuelle -->
            <HorizontalStackLayout Grid.Row="2" Spacing="20" Padding="4,4,4,0">
                <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                    <Ellipse WidthRequest="10" HeightRequest="10"
                             Fill="{StaticResource BrandBrush}"
                             Stroke="{StaticResource WhiteBrush}"
                             StrokeThickness="1" VerticalOptions="Center"/>
                    <Label Text="Equipement mobile" Style="{StaticResource LabelDiscret}" VerticalOptions="Center"/>
                </HorizontalStackLayout>

                <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                    <Rectangle WidthRequest="16" HeightRequest="10"
                               Fill="{StaticResource Gray500Brush}"
                               Stroke="{StaticResource Gray600Brush}"
                               StrokeThickness="1" VerticalOptions="Center"/>
                    <Label Text="Machine fixe" Style="{StaticResource LabelDiscret}" VerticalOptions="Center"/>
                </HorizontalStackLayout>

                <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                    <Line X1="0" Y1="0" X2="18" Y2="0"
                          Stroke="{StaticResource WarningBrush}"
                          StrokeThickness="2" StrokeDashArray="3,2" VerticalOptions="Center"/>
                    <Label Text="Perimetre securite" Style="{StaticResource LabelDiscret}" VerticalOptions="Center"/>
                </HorizontalStackLayout>

                <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                    <Rectangle WidthRequest="16" HeightRequest="12"
                               Fill="{StaticResource DangerBrush}"
                               Opacity="0.3"
                               Stroke="{StaticResource DangerBrush}"
                               StrokeThickness="1" VerticalOptions="Center"/>
                    <Label Text="Zone interdite" Style="{StaticResource LabelDiscret}" VerticalOptions="Center"/>
                </HorizontalStackLayout>
            </HorizontalStackLayout>

            <!-- Message d'erreur (rare) -->
            <Border Grid.Row="3"
                    Style="{StaticResource BorderAlerteDanger}"
                    IsVisible="{Binding MessageErreur, Converter={StaticResource ConvertisseurTexteVersVisible}}">
                <Label Text="{Binding MessageErreur}"
                       TextColor="{StaticResource OnDangerMuted}"
                       FontSize="{StaticResource FontSize}"/>
            </Border>
        </Grid>

        <!-- Voile invisible : tape n'importe ou ferme les panneaux ouverts -->
        <BoxView Color="Transparent"
                 IsVisible="{Binding PanneauAlertesOuvert}"
                 InputTransparent="False">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding FermerPanneauxCommand}"/>
            </BoxView.GestureRecognizers>
        </BoxView>
        <BoxView Color="Transparent"
                 IsVisible="{Binding PanneauMenuOuvert}"
                 InputTransparent="False">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding FermerPanneauxCommand}"/>
            </BoxView.GestureRecognizers>
        </BoxView>

        <!-- Panneau flottant des alertes -->
        <Border IsVisible="{Binding PanneauAlertesOuvert}"
                Background="{AppThemeBinding Light={StaticResource N0}, Dark={StaticResource N800}}"
                Stroke="{AppThemeBinding Light={StaticResource N200}, Dark={StaticResource N600}}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 8"
                HorizontalOptions="End"
                VerticalOptions="Start"
                WidthRequest="340"
                MaximumHeightRequest="360"
                Margin="0,54,60,0">
            <Grid RowDefinitions="Auto,*,Auto" Padding="0">
                <Grid Grid.Row="0" Padding="14,10" ColumnDefinitions="*,Auto"
                      BackgroundColor="{AppThemeBinding Light={StaticResource N50}, Dark={StaticResource N700}}">
                    <Label Text="Alertes recentes"
                           Style="{StaticResource LabelTitreCarte}"
                           VerticalOptions="Center"/>
                    <Label Grid.Column="1"
                           Text="{Binding Alertes.Count, StringFormat='{0} au total'}"
                           Style="{StaticResource LabelDiscret}"
                           FontSize="{StaticResource FontSizeS}"
                           VerticalOptions="Center"/>
                </Grid>

                <CollectionView Grid.Row="1"
                                ItemsSource="{Binding Alertes}"
                                Margin="0,4">
                    <CollectionView.EmptyView>
                        <Label Text="Aucune alerte en cours."
                               Style="{StaticResource LabelDiscret}"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               Padding="20"/>
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:AlerteApercu">
                            <Grid Padding="14,8" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                <Label Text="⚠"
                                       TextColor="{StaticResource Danger}"
                                       FontSize="{StaticResource FontSizeM}"
                                       VerticalOptions="Center"/>
                                <Label Grid.Column="1" VerticalOptions="Center" FontSize="{StaticResource FontSize}">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{Binding CodeEquipement}"
                                                  FontAttributes="Bold"
                                                  TextColor="{StaticResource OnDangerMuted}"/>
                                            <Span Text=" · "
                                                  TextColor="{AppThemeBinding Light={StaticResource N500}, Dark={StaticResource N300}}"/>
                                            <Span Text="{Binding ZoneNom}"
                                                  TextColor="{AppThemeBinding Light={StaticResource N700}, Dark={StaticResource N100}}"/>
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                                <Label Grid.Column="2"
                                       Text="{Binding HeureFormattee}"
                                       Style="{StaticResource LabelDiscret}"
                                       FontSize="{StaticResource FontSizeS}"
                                       VerticalOptions="Center"/>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Button Grid.Row="2"
                        Style="{StaticResource BoutonDangerOutline}"
                        Text="Effacer toutes les alertes"
                        FontSize="{StaticResource FontSizeS}"
                        Padding="10,6"
                        Margin="8"
                        Command="{Binding EffacerAlertesCommand}"
                        IsVisible="{Binding Alertes.Count, Converter={StaticResource ConvertisseurCompteVersVisible}}"/>
            </Grid>
        </Border>

        <!-- Panneau flottant du menu -->
        <Border IsVisible="{Binding PanneauMenuOuvert}"
                Background="{AppThemeBinding Light={StaticResource N0}, Dark={StaticResource N800}}"
                Stroke="{AppThemeBinding Light={StaticResource N200}, Dark={StaticResource N600}}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 6"
                HorizontalOptions="End"
                VerticalOptions="Start"
                WidthRequest="220"
                Margin="0,54,12,0"
                Padding="4">
            <VerticalStackLayout>
                <!-- Items de menu : Label dans une Grid tappable pour un vrai alignement gauche -->
                <Grid Padding="12,10">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding RafraichirCommand}"/>
                    </Grid.GestureRecognizers>
                    <Label Text="↻  Rafraichir"
                           Style="{StaticResource LabelCorps}"
                           FontSize="{StaticResource FontSizeM}"/>
                </Grid>
                <BoxView HeightRequest="1"
                         Color="{AppThemeBinding Light={StaticResource N100}, Dark={StaticResource N600}}"/>
                <Grid Padding="12,10">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding BasculerPrecisionCommand}"/>
                    </Grid.GestureRecognizers>
                    <Label Style="{StaticResource LabelCorps}"
                           FontSize="{StaticResource FontSizeM}">
                        <Label.Text>
                            <MultiBinding StringFormat="{}{0}  Precision">
                                <Binding Path="AfficherPrecision" Converter="{StaticResource ConvertisseurEtatPrecision}"/>
                            </MultiBinding>
                        </Label.Text>
                    </Label>
                </Grid>
                <BoxView HeightRequest="1"
                         Color="{AppThemeBinding Light={StaticResource N100}, Dark={StaticResource N600}}"/>
                <Grid Padding="12,10">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OuvrirHistoriqueCommand}"/>
                    </Grid.GestureRecognizers>
                    <Label Text="📋  Historique des alertes"
                           Style="{StaticResource LabelCorps}"
                           FontSize="{StaticResource FontSizeM}"/>
                </Grid>
            </VerticalStackLayout>
        </Border>

    </Grid>
</ContentPage>
